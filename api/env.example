# Copy this to .env and fill in real values.
# .env is gitignored and never committed.

# Absolute path to the directory containing your journal file
JOURNAL_DIR=/path/to/journal-repo
JOURNAL_FILE=/path/to/journal-repo/main.journal

# Chart-of-accounts journal (account directives). When set, /accounts serves
# the declared accounts from this file instead of accounts used in the journal.
ACCOUNTS_FILE=/path/to/journal-repo/accounts.journal

# A strong random secret — generate with: openssl rand -hex 32
BEARER_TOKEN=YOUR_TOKEN

# Currency symbol used in your journal
DEFAULT_CURRENCY=$

# Transaction inbox staging file (lives in the journal repo, committed like envelopes)
INBOX_DATA_FILE=/path/to/journal-repo/inbox.json

HLEDGER_BIN=/usr/local/bin/hledger
