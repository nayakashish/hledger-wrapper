# Copy this to .env and fill in real values.
# .env is gitignored and never committed.

# Absolute path to the git repo that holds your journals.
JOURNAL_DIR=/path/to/journal-repo

# ── Active journal (the app's journal switcher) ─────────────────────────────
# A journal is a self-contained folder under JOURNAL_DIR:
#
#   <JOURNAL_DIR>/
#     2026/
#       2026.journal        # the journal itself (matches the folder name)
#       accounts.journal    # optional chart-of-accounts directives
#       envelopes.json      # per-journal envelope store (auto-created)
#       inbox.json          # per-journal inbox store (auto-created)
#     2027/
#       2027.journal ...
#
# APP_CONFIG_FILE points at a small server-local JSON the app writes when you
# pick a journal in Settings -> Config, e.g.
# {"active_journal": "2026", "inbox_journal": "2026"}. When active_journal is
# set, the journal / accounts / envelopes paths (and the inbox paths for
# everything except email ingest) are resolved from that journal's folder —
# the JOURNAL_FILE/ACCOUNTS_FILE/... vars below are only the fallback used
# before a journal has ever been selected.
#
# inbox_journal is a second, independent pointer: it's the only thing that
# decides where inbound bank-alert emails land, regardless of which journal
# is active for viewing. It must be picked explicitly in Settings — there is
# no default and it never falls back to active_journal, so switching what
# you're browsing (e.g. to the demo journal) can never redirect real alerts.
# The demo journal can never be picked as the inbox target. If folder-based
# journals exist at all and inbox_journal isn't set (or points at a folder
# that no longer exists), /inbox/ingest rejects incoming alerts (they stay in
# Gmail for manual re-forwarding) rather than guessing a target.
APP_CONFIG_FILE=/path/to/journal-repo/app_config.json

# ── Fallback single-journal config (used only when no journal is selected) ──
# Kept for backward compatibility with a flat, pre-folder setup. Once you select
# a journal in the app these are ignored.
JOURNAL_FILE=/path/to/journal-repo/2026/2026.journal
ACCOUNTS_FILE=
ENVELOPE_DATA_FILE=
INBOX_DATA_FILE=

# A strong random secret — generate with: openssl rand -hex 32
BEARER_TOKEN=YOUR_TOKEN

# Currency symbol used in your journal
DEFAULT_CURRENCY=$

HLEDGER_BIN=/usr/local/bin/hledger
