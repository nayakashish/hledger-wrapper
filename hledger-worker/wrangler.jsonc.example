// Template for wrangler.jsonc. Copy it and fill in your own values:
//   cp wrangler.jsonc.example wrangler.jsonc
// wrangler.jsonc is gitignored so the real email and domain never get committed.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hledger-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"redact_query_string": false
	},
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"vars": {
		// Gmail forwarding-confirmation emails get forwarded here (must be a
		// verified destination address in Email Routing)
		"FORWARD_VERIFICATION_EMAIL": "you@example.com"
	},
	"routes": [
		{
			"pattern": "hledger.example.com",
			"zone_name": "example.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	/**
	 * Secrets (set via wrangler CLI, never committed):
	 *   wrangler secret put BEARER_TOKEN
	 *   wrangler secret put CF_ACCESS_CLIENT_ID
	 *   wrangler secret put CF_ACCESS_CLIENT_SECRET
	 *   wrangler secret put API_BASE_URL
	 */
}